{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://edufleetexchange.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "main": false,
      "dev": true,
      "stage": true,
      "prod": true
    }
  }
}