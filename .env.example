# ============================================================
# eduFleet Exchange — FRONTEND env (.env)
# Copy to .env (gitignored). Vite only exposes vars prefixed VITE_.
# ============================================================

# Backend API base URL.
# - dev:  http://localhost:5000/api
# - prod: handled by vercel.json rewrite (/api/* → Render), so this can be
#         left as the default; set explicitly only if you bypass the rewrite.
VITE_API_BASE_URL=http://localhost:5000/api

# --- Payment details shown on the subscription page (optional) ---
# If unset, the UI shows a safe "contact support" fallback instead of bank
# details. Account number is masked to last 4 digits when shown.
VITE_PAYMENT_ACCOUNT_NAME=
VITE_PAYMENT_BANK_NAME=
VITE_PAYMENT_ACCOUNT_NUMBER=
VITE_PAYMENT_IFSC=
VITE_PAYMENT_SUPPORT_EMAIL=
VITE_PAYMENT_SUPPORT_PHONE=
